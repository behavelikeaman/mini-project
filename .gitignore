# ============================================
# .gitignore — git 이 "추적하지 않을" 파일 목록
# 여기 적힌 경로는 git add 를 해도 무시되고 GitHub 에 올라가지 않는다.
# ============================================

# 이 저장소에는 Test-Project 만 올린다.
# 아래 두 폴더는 로컬에만 두고 공개하지 않는다.
# (나중에 올리고 싶어지면 해당 줄을 지우고 git add 하면 된다)
/harness-project/
/stock/

# ---- 아래는 어떤 프로젝트에서든 올리면 안 되는 것들 ----

# Windows / macOS 가 자동으로 만드는 쓰레기 파일
Thumbs.db
desktop.ini
.DS_Store

# 에디터 설정 (사람마다 달라서 공유할 필요가 없다)
.vscode/
.idea/

# 비밀번호·API 키가 들어가는 파일 — 절대 올리지 말 것
.env
.env.local
*.key

# 나중에 npm 을 쓰게 되면 필요해지는 항목
# (수만 개 파일이라 올리지 않고, package.json 만 올리는 게 관례)
node_modules/

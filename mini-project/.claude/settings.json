{
  "extraKnownMarketplaces": {
    "behavelikeaman-plugins": {
      "source": {
        "source": "github",
        "repo": "behavelikeaman/mini-project"
      }
    }
  },
  "enabledPlugins": {
    "ai-readiness-plugin@behavelikeaman-plugins": true
  },
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__visualize__read_me"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tdd-guard.sh",
            "shell": "bash",
            "timeout": 15
          }
        ]
      }
    ]
  }
}

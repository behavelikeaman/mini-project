# ============================================
# 환경변수 템플릿
# 실제 값이 들어간 .env 파일은 절대 커밋하지 말 것 (.gitignore에 등록됨)
# 사용법: 이 파일을 복사해서 .env로 만들고 실제 값을 채워넣는다.
#   cp .env.example .env
# ============================================

# 앱 실행 환경 (development | production | test)
NODE_ENV=development

# 서버 포트
PORT=3000

# 데이터베이스 접속 정보
DATABASE_URL=

# API 키 / 시크릿
API_KEY=
SECRET_KEY=

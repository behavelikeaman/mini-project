# ============================================
# mini-project 전용 .gitignore
# 상위(Projects) 저장소의 공통 규칙에 더해 이 프로젝트에만 적용되는 규칙
# ============================================

# 환경변수 / 비밀키 — 절대 커밋 금지
.env
.env.local
.env.*.local
*.key

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/

# Python
__pycache__/
*.pyc
.venv/
venv/

# 로그 / 캐시
*.log
.cache/

# OS / 에디터 쓰레기 파일
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

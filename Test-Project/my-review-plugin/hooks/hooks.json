{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-commit-check.sh\"",
            "timeout": 180,
            "statusMessage": "커밋 전 검사 중 (lint/build/test)"
          }
        ]
      }
    ]
  }
}
